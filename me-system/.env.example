# Copy this file to .env.local and fill in the values. .env.local is ignored by git.
#
# Leave both empty (or delete .env.local) to run the demo only: simulated roles, nothing saved.
#
# Option A: your local Supabase stack (npx supabase start). Get the key from: npx supabase status
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Option B: the live Supabase project (careful: you will be reading and writing real data)
# NEXT_PUBLIC_SUPABASE_URL=https://cvutbidnazfgfbeptnbz.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Uyd1j90H7_LXQ4IDO8cXqw_KP0YTASC
#
# Both values are public by design (they are sent to every browser). Row-level security in the
# database decides what each signed-in person can see. NEVER put the secret / service_role key here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
